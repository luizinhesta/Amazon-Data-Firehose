{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnviarAoFluxoDoLab",
      "Effect": "Allow",
      "Action": "firehose:PutRecordBatch",
      "Resource": "arn:aws:firehose:us-east-1:<ACCOUNT_ID>:deliverystream/integracao-lab04-fh"
    },
    {
      "Sid": "GravarRun",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/integracao-lab04-runs"
    }
  ]
}