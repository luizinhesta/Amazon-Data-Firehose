{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LerTabelaDoLab",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/integracao-lab04-runs"
    },
    {
      "Sid": "ListarArquivosDoBucketDeDados",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::integracao-lab04-dados-<ACCOUNT_ID>"
    },
    {
      "Sid": "LerArquivosDoBucketDeDados",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::integracao-lab04-dados-<ACCOUNT_ID>/*"
    },
    {
      "Sid": "LerMetricasDoCloudWatch",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricData",
      "Resource": "*"
    }
  ]
}